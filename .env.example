# ──────────────────────────────────────────────────────────────
# Firebase Client SDK  (NEXT_PUBLIC_ prefix → exposed to browser)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ──────────────────────────────────────────────────────────────
# Firebase Admin SDK  (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# Generate via: Firebase Console → Project Settings → Service Accounts
# ──────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Newlines in the private key must be escaped as \n in .env files
FIREBASE_ADMIN_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────
# External Nutrition API  (SERVER ONLY)
# ──────────────────────────────────────────────────────────────
NUTRITION_API_KEY=
NUTRITION_API_BASE_URL=https://api.edamam.com/api/food-database/v2

# Optional: Edamam app credentials
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# ──────────────────────────────────────────────────────────────
# App-level settings
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nutritrack.it
ADMIN_EMAIL=admin@nutritrack.it
